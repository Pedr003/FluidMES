{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "server",
      "framework": "django",
      "entrypoint": "config.wsgi:application",
      "installCommand": "pip install -r requirements.cloud.txt",
      "buildCommand": "python vercel_build.py"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/admin", "destination": { "service": "backend" } },
    { "source": "/admin/:path*", "destination": { "service": "backend" } },
    { "source": "/static/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
